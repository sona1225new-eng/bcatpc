# ==================================================
# T.P. College Backend — Environment Variables Example
# Copy this file to .env and fill in your real values
# DO NOT commit .env to version control
# ==================================================

PORT=5000
NODE_ENV=development
# MongoDB Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/bcatpc_local_test?retryWrites=true&w=majority&appName=bcatpc

# Client Application URL (React/Vite Frontend or Admin Dashboard)
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=replace_with_a_secure_random_string_at_least_64_characters
JWT_EXPIRES_IN=7d

# Initial Superadmin Credentials for scripts/seedAdmin.js
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@tpcollege.ac.in
ADMIN_PASSWORD=Admin@SecurePassword123

# Required in production for persistent gallery image and faculty resume storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Maximum upload size in MB for image and resume uploads
MAX_UPLOAD_SIZE_MB=5
