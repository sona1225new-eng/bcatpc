# ==================================================
# T.P. College Backend — Environment Variables Example
# Copy this file to .env and fill in your real values
# DO NOT commit .env to version control
# ==================================================

PORT=5000
NODE_ENV=development
# MongoDB Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/bcatpc?retryWrites=true&w=majority

# Client Application URL (React/Vite Frontend or Admin Dashboard)
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=replace_with_a_secure_random_string_at_least_64_characters
JWT_EXPIRES_IN=7d

# Initial Superadmin Credentials for scripts/seedAdmin.js
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@tpcollege.ac.in
ADMIN_PASSWORD=Admin@SecurePassword123
